# --- data and model artefacts (regenerated by the pipeline; see README) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
checkpoints/

# --- experiment outputs: keep configs, histories, metrics and logs; drop large arrays ---
experiments/dev/
experiments/mlflow/
experiments/**/*.npy
experiments/**/*.npz
experiments/**/.claim
experiments/*.out
experiments/*.err
experiments/*.log

# --- python ---
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# --- secrets ---
.env
kaggle.json

# --- scratch ---
scripts/_*.py
